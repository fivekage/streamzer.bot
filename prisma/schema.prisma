generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model role {
  id   Int     @id @default(autoincrement())
  name String? @db.VarChar(45)
  user user[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model user {
  id                  Int                @id @default(autoincrement())
  role_id             Int?
  id_discord_account  String?            @unique(map: "idDiscordAccount_UNIQUE") @db.VarChar(255)
  id_jellyfin_account String?            @unique(map: "id_jellyfin_account_UNIQUE") @db.VarChar(255)
  email               String?            @unique(map: "email_UNIQUE") @db.VarChar(255)
  username            String             @db.VarChar(255)
  password            String?            @db.VarChar(255)
  created_at          DateTime           @default(now()) @db.DateTime(0)
  updated_at          DateTime           @default(now()) @db.DateTime(0)
  role                role?              @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_role1")
  user_connections    user_connections[]

  @@index([role_id], map: "fk_user_role1_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model user_connections {
  id               Int      @id @default(autoincrement())
  user_id          Int
  connection_at    DateTime @default(now()) @db.DateTime(0)
  connection_ip    String   @db.VarChar(45)
  location         String?  @db.VarChar(255)
  device_type      String?  @db.VarChar(50)
  browser_info     String?  @db.VarChar(255)
  operating_system String?  @db.VarChar(255)
  user_agent       String?  @db.VarChar(255)
  user             user     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_UserConnections_Users1")

  @@index([user_id], map: "fk_UserConnections_Users1_idx")
}
